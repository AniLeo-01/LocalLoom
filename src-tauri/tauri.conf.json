{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLoom",
  "version": "0.1.0",
  "identifier": "dev.openloom.smolvlm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenLoom",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "macOS": {
      "entitlements": null,
      "infoPlist": "Info.plist"
    }
  }
}
